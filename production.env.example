# Copy this file to .env.prod. Fill in both required secrets before starting production.
DB_NAME=library
DB_USER=library_api
DB_PASS=
JWT_SECRET=

# Database bootstrap is disabled by default. Set to 'always' only for the first
# startup of a brand-new production database, then remove it or set it back to 'never'.
DB_SCHEMA_INIT_MODE=never
# Optional demo fixtures: classpath:data.sql,classpath:data-dev.sql
DB_SEED_DATA_LOCATIONS=classpath:data.sql

JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000
JWT_ISSUER=library-api
JWT_AUDIENCE=library-api-clients
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
API_PORT=8080

# RabbitMQ credentials (required by docker-compose.prod.yml)
RABBITMQ_USER=library_api
RABBITMQ_PASS=
