# Local PostgreSQL connection when running the API outside Docker
DB_URL=jdbc:postgresql://localhost:5432/library
DB_NAME=library
DB_USER=postgres
DB_PASS=postgres

# Runtime profile for local development
SPRING_PROFILES_ACTIVE=dev

# JWT settings (the dev profile has a local-only fallback secret)
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000
JWT_ISSUER=library-api
JWT_AUDIENCE=library-api-clients
