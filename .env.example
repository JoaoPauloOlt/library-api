# Database
DB_URL=jdbc:postgresql://localhost:5432/library
DB_USER=postgres
DB_PASS=postgres

# Spring
SPRING_PROFILES_ACTIVE=dev

# JWT - generate a strong Base64-encoded secret for real environments
JWT_SECRET=replace-with-a-strong-base64-secret
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000
JWT_ISSUER=library-api
JWT_AUDIENCE=library-api-clients
